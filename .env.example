# Copy to .env. Never commit .env.
PORKBUN_API_KEY=pk1_...
PORKBUN_SECRET_KEY=sk1_...
CLOUDFLARE_API_TOKEN=...    # account-owned API token (Edit Cloudflare Workers + Zone/DNS/SSL for the custom domain)
CLOUDFLARE_ACCOUNT_ID=...    # the one account this project may touch
RECEIVE_ADDRESS=0x...   # Base USDC, receive-only
X402_TEST_PAYER_KEY=0x...   # throwaway Base Sepolia payer for scripts/x402-pay.mjs; never holds real funds

# IndexNow key (indexnow.org); also set as a Worker secret. Any 8-128 chars of [A-Za-z0-9-].
INDEXNOW_KEY=
