# /etag witness: Apache Traffic Server as a caching reverse proxy in front of the recorder.
# Rendered by ../drivers/proxy.mjs into <dir>/ats/etc/records.yaml; every other file in that directory is the
# package's shipped default except remap.config and storage.config (see trafficserver.remap.config.tmpl).
records:
  http:
    server_ports: {{PORT}}:ipv4:ip-in=127.0.0.1
    insert_response_via_str: 2
    cache:
      http: 1
{{ATS_REQUIRED_HEADERS}}
  reverse_proxy:
    enabled: 1
  url_remap:
    remap_required: 1
